<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Watch Bezel Ring with metallic sheen -->
    <path
        android:pathData="M54,26 A28,28 0 1,1 53.9,26 Z"
        android:strokeWidth="3.5"
        android:strokeColor="#00C4DF" />

    <!-- Inner bezel markers -->
    <path
        android:pathData="M54,29 L54,33 M54,75 L54,79 M31,54 L35,54 M73,54 L77,54"
        android:strokeWidth="2.5"
        android:strokeColor="#FF7A00"
        android:strokeLineCap="round" />

    <!-- Sub-dial Health Complication Ring (Heart Rate / Step Ring) -->
    <path
        android:pathData="M54,40 A7,7 0 1,1 53.9,40 Z"
        android:strokeWidth="1.8"
        android:strokeColor="#38E54D" />

    <!-- Watch Hands (Sport Skeleton Luminous) -->
    <!-- Hour Hand -->
    <path
        android:pathData="M54,54 L44,44"
        android:strokeWidth="3.8"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Minute Hand -->
    <path
        android:pathData="M54,54 L68,36"
        android:strokeWidth="3.2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Second Hand (Vibrant Ultra Orange with tail) -->
    <path
        android:pathData="M54,60 L54,31"
        android:strokeWidth="1.8"
        android:strokeColor="#FF5722"
        android:strokeLineCap="round" />

    <!-- Center Pivot Pin -->
    <path
        android:pathData="M54,54 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"
        android:fillColor="#FF5722" />
    <path
        android:pathData="M54,54 m-1.2,0 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0"
        android:fillColor="#FFFFFF" />

</vector>
